# Add these in Vercel Dashboard → Project → Settings → Environment Variables
# (Apply to: Production, Preview, Development)

# Resend API key (required) — from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender — must use a verified domain in Resend
RESEND_FROM=Village Pizza & Seafood <john@villagepizzaseafood.com>

# Where contact/feedback notifications are delivered
CONTACT_NOTIFY_TO=john@villagepizzaseafood.com
