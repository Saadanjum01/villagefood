# MongoDB
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=villagefood

# CORS — comma-separated list of allowed frontend origins (use * for local dev only)
CORS_ORIGINS=http://localhost:3000

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The verified "from" address in your Resend account / domain
# During testing you can use: onboarding@resend.dev  (sends to your own account only)
RESEND_FROM=no-reply@villagepizzaseafood.com

# Where notification emails are delivered
CONTACT_NOTIFY_TO=hello@villagepizzaseafood.com
